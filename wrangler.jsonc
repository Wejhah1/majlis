{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majlis",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*", "/media/*"]
  },
  // Group data never lives here: it is stored in D1 and edited from /admin.
  // D1 is created automatically on first deploy (no IDs to copy around).
  "d1_databases": [{ "binding": "DB", "database_name": "majlis" }],
  // Optional: store photos in R2 instead of D1 (needs R2 enabled on your account):
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "majlis-media" }],
  "durable_objects": {
    "bindings": [
      { "name": "Rooms", "class_name": "RoomsServer" },
      { "name": "RateGuard", "class_name": "RateGuardServer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomsServer", "RateGuardServer"] }],
  "observability": { "enabled": true }
}
